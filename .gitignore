# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# raw saved agent tensors and world-model checkpoints -- regenerable, not
# versioned (see CONTRIBUTING.md, "what gets versioned")
results/agents/**/*.npz
results/online/snapshots/**/*.npz
results/**/snapshots/**/*.npz
results/**/checkpoints/**
results/E2_online_4zones/**/raw.npz
# sweep's bulk per-run data (~291MB, bit-for-bit regenerable given full
# determinism -- see rng.py/README.md) -- summary.json/meta.yaml (small,
# useful for quick inspection without rerunning) stay tracked.
results/E2_online_4zones_sweep/**/arrays.npz
results/E2_online_4zones_sweep/**/per_state.csv
results/E2_online_4zones_sweep/**/per_pair.csv

# matplotlib / notebook scratch output
notebooks/.ipynb_checkpoints/
*.ipynb_checkpoints/
scratch/
*.scratch.png

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# virtual environments
.venv/
.venv-cluster/
.cluster-home/
venv/
env/

# pytest
.pytest_cache/

# E3 (docs/e3/DECISIONS.md, 2026-09-25): model checkpoints saved by the
# training guards (failure/ of a run, and the older mini_failures/), the
# per-seed bulk arrays (regenerable from the run's config + commit), and
# throw-away dry-run output.
results/**/failure/**/*.pt
results/**/mini_failures/**/*.pt
results/E3_worldmodel_4zones/**/arrays.npz
results/_dryrun*/
# Cluster GPU outputs are downloaded as a complete, unversioned dataset.
results/E3_worldmodel_4zones/*worldmodel-gpu_e30*/

# Preflight runs and GPU launch logs (experiments/E3_worldmodel_4zones/preflight.py, launch_gpu_e30.sh)
results/preflight/
logs/

# Paper (paper/): LaTeX build products. paper/figures/out/ and
# paper/numbers.tex stay versioned, so the paper compiles without the raw
# results and the diff of numbers.tex shows what changed between runs.
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.toc
paper/**/*.lof
paper/**/*.lot
paper/**/*.tdo
paper/**/*.synctex.gz
paper/main.pdf

# E3 handoff archives extracted for the E3 report (paper/reports/; see paper/README.md):
# local copies of what handoff/ holds.
results/E3_worldmodel_4zones/*gpu_pilot_closed_loop*/
results/E3_worldmodel_4zones/gpu_pilot_remeasure/
results/E3_worldmodel_4zones/gpu_pilot_noise/
paper/reports/*.pdf
results/E3_worldmodel_4zones/gpu_campaign/

# Heavy artefacts never versioned (reorganisation 2026-10-14, docs/RESULTS_CONVENTION.md):
# GPU batch handoffs (archives, weights, buffers) stay on the cluster storage or in a local copy;
# what a batch returns to git goes to its own orphan branch results/<batch>.
# The handoffs and logs versioned before 2026-10-14 remain in the history.
handoff/
**/wandb/
**/replay.npz
*.pt
# The E3 campaign's extracted runs and RSA outputs; its summaries (analysis.json, tables/,
# CAMPAIGN_ANALYSIS.md, RESULTS_SECTION.md) are versioned.
results/E3_worldmodel_4zones/campaign/runs/
results/E3_worldmodel_4zones/campaign/rsa/

# E4 batch archives written by experiments/E4_generalization_gradient/export_batch.py (downloaded, never versioned)
exports/

# The agent_mini bench run (E3): the paper reads only its diagnostics, versioned under reports/; the run itself stays local.
results/E3_worldmodel_4zones/grid12x12__4zones__pair-experimental__worldmodel-agent-agent_mini__seed00__20260930T193212Z/
